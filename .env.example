GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Optional. Leave empty to use `gcloud auth application-default login` credentials.
# On a server, set to the path of a service-account JSON kept outside git (e.g. ./secrets/vertex.json).
GOOGLE_APPLICATION_CREDENTIALS=

# Database (SQLite file by default) and job queue
DATABASE_URL=file:storage/app.sqlite
REDIS_URL=redis://127.0.0.1:6379
